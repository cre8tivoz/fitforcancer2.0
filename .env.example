# Required server-side Gemini credential.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional shared access gate for /api/gemini.
# Leave unset/blank for public mode.
CHAT_ACCESS_PASSWORD=
# Legacy/alternate server variable also supported:
# FFC_CHAT_ACCESS_PASSWORD=

# Optional durable Upstash rate limiting across serverless instances.
# If omitted, /api/gemini falls back to best-effort in-memory limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
